# Server port
PORT=3001

# MQTT broker (used when MQTT_URL is not set)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_PROTOCOL=mqtt

# Optional: full MQTT URL overrides MQTT_BROKER + MQTT_PORT
# MQTT_URL=mqtt://broker.hivemq.com:1883

# Subscribe topics (comma-separated)
MQTT_TOPICS="/gw/#,gw/#"

# Load docs/sample-data on startup (dev only)
LOAD_SAMPLE_DATA=false